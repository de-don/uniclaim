  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts",
    "preview": "vite preview",
    "verify": "tsx scripts/verify-fees.ts",
    "check:rpcs": "tsx scripts/check-rpcs.ts",
    "verify:v4": "tsx scripts/verify-v4.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "ws@8": ">=8.21.3",
      "decode-uri-component": ">=0.5.0"
