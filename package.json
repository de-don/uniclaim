{
  "name": "uniclaim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.56.8",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  },
  "description": "Соберите комиссии со всех Uniswap V3 позиций одной транзакцией",
  "license": "BUSL-1.1",
  "packageManager": "pnpm@10.11.1",
  "repository": {
    "type": "git",
